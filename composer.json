{
    "name": "hybrid-agent/rubixml-hybrid-agent",
    "description": "A high-performance Hybrid AI Agent for PHP, combining Neural Networks and Minimax algorithms using RubixML and the Tensor extension.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "rubix/ml": "^2.5.3",
        "rubix/tensor": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "HybridAgent\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HybridAgent\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit tests",
        "play": "php examples/play.php"
    },
    "minimum-stability": "stable"
}
